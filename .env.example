# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never exposed to the browser. Project Settings > API >
# service_role secret. Used only by the KakaoTalk notification routes
# (src/app/api/notify/*) to look up another user's stored kakao_tokens row,
# which RLS otherwise locks to "your own row only".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kakao Developers > 내 애플리케이션 > 앱 키. Same REST API 키/Client Secret
# already entered into Supabase's Kakao auth provider config — needed here
# too because the notification routes call Kakao's token-refresh and
# memo-send APIs directly, bypassing Supabase's OAuth wrapper.
KAKAO_CLIENT_ID=your-kakao-rest-api-key
# Only needed if "Client Secret 사용" is turned on for this Kakao app.
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Public site URL, used to build the deep link included in KakaoTalk
# notifications (e.g. https://running-challenge-rho.vercel.app). Optional —
# notifications still send without it, just without a tappable link.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
